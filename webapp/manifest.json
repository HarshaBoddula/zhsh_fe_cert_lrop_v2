                },
                "4": {
                  "key": "PLANNED",
                  "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#PLANNED"
                }
              }
            },
            "enableTableFilterInPageVariant": true,
            "filterSettings": {
              "dateSettings": {
                "useDateRange": true
              },
              "historySettings": {
                "fields": {
                  "CertCategory": {
                    "historyEnabled": "enabled"
